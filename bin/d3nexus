#!/usr/bin/env python3
"""Portable entrypoint for d3nexus tools."""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

KIT_ROOT = Path(__file__).resolve().parent.parent

SUBCOMMANDS: dict[str, str] = {
    "audit-account-block": "skills/audit-account-block/resources/scripts/audit_account_block.py",
    "audit-epic": "skills/dev-implementation/resources/scripts/audit_epic.py",
    "check-bdd": "skills/dev-implementation/resources/scripts/check_bdd_traceability.py",
    "check-contract": "skills/dev-implementation/resources/scripts/check_task_contract.py",
    "check-doc": "skills/doc_quality_check/resources/scripts/check_document.py",
    "check-impact": "skills/impact-analysis/resources/scripts/check_code_impact.py",
    "check-quota": "scripts/agy_quota.py",
    "check-readiness": "skills/dev-implementation/resources/scripts/check_epic_readiness.py",
    "integrate": "skills/finishing-a-development-branch/resources/scripts/integrate_branch.py",
    "package-epic": "skills/dev-implementation/resources/scripts/package_epic.py",
    "quality-check": "skills/quality_check/resources/scripts/verify_polyglot_registry.py",
    "resume-context": "scripts/resume_context.py",
    "run-checks": "skills/dev-implementation/resources/scripts/run_task_checks.py",
    "run-external-review": "skills/dev-implementation/resources/scripts/run_external_review.py",
    "sync-status": "skills/dev-implementation/resources/scripts/sync_task_status.py",
}


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Usage: d3nexus <subcommand> [args...]")
        print("Available subcommands: " + ", ".join(sorted(SUBCOMMANDS.keys())))
        return 0 if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help") else 2

    subcmd = sys.argv[1]
    rel_path = SUBCOMMANDS.get(subcmd)
    if not rel_path:
        sys.stderr.write(f"d3nexus: unknown subcommand '{subcmd}'\n")
        sys.stderr.write("Available subcommands: " + ", ".join(sorted(SUBCOMMANDS.keys())) + "\n")
        return 2

    target = KIT_ROOT / rel_path
    if not target.is_file():
        sys.stderr.write(f"d3nexus: target script not found: {target}\n")
        return 2

    cmd = [sys.executable, str(target)] + sys.argv[2:]
    res = subprocess.run(cmd)
    return res.returncode


if __name__ == "__main__":
    sys.exit(main())
