{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "moduleResolution": "node",
    "allowJs": true,
    "strict": true,
    "maxNodeModuleJsDepth": 1
  },
  "include": [
    "src/**/*.js",
    "preview/static/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
