{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Quality Registry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skill",
          "required",
          "profiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "skill": {
            "type": "string",
            "pattern": "^d3nexus:[a-z0-9_-]+$"
          },
          "required": {
            "type": "boolean"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "pr",
                "epic",
                "scheduled",
                "release"
              ]
            }
          }
        }
      }
    }
  }
}
