{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider Result Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "contract_version",
    "profile",
    "repository_sha",
    "status",
    "checks",
    "coverage",
    "evidence",
    "started_head",
    "finished_head",
    "duration",
    "blockers",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "pr",
        "epic",
        "scheduled",
        "release"
      ]
    },
    "repository_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "started_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "finished_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "status",
          "source",
          "duration",
          "summary",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "source": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "summary": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_applicable_reason": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measured",
          "threshold"
        ],
        "properties": {
          "measured": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "source",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    }
  }
}
